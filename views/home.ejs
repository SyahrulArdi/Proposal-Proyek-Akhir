<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        body { background-color: #1a1a2e; font-family: sans-serif; }
        .app-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); gap: 20px; padding: 20px; max-width: 400px; margin: 20px auto; }
        .app-icon { background-color: #16213e; border-radius: 15px; padding: 15px; text-align: center; color: white; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 4px 10px rgba(0,0,0,0.2); }
        .app-icon:hover { transform: translateY(-5px); box-shadow: 0 8px 15px rgba(41, 98, 255, 0.3); }
        .app-icon i { font-size: 2rem; margin-bottom: 8px; color: #5372f0; }
        .app-icon span { display: block; font-size: 0.8rem; }
    </style>
</head>
<body class="pt-5">
    <h1 class="text-2xl font-bold text-white text-center mb-5">Aplikasi Saya</h1>
    <div class="app-grid">
        <a href="/bank" class="app-icon">
            <i class="fas fa-wallet"></i>
            <span>Bank Saya</span>
        </a>
        </div>
</body>
</html>